{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/grade.js": {
      "maxDuration": 60,
      "includeFiles": "board.html"
    },
    "api/espn.js": {
      "maxDuration": 30
    },
    "api/record.js": {
      "maxDuration": 10
    },
    "api/tick.js": {
      "maxDuration": 60,
      "includeFiles": "board.html"
    },
    "api/upcoming.js": {
      "maxDuration": 60,
      "includeFiles": "api/_logit.json"
    },
    "api/applog.js": {
      "maxDuration": 60,
      "includeFiles": "{api/_logit.json,verdict.js}"
    }
  },
  "rewrites": [
    {
      "source": "/pro",
      "destination": "/board.html"
    }
  ]
}