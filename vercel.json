{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/grade.js": {
      "maxDuration": 60,
      "includeFiles": "index.html"
    },
    "api/record.js": {
      "maxDuration": 10
    }
  }
}